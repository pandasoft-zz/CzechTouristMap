root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# XML (Maven) — 4-space indent
[*.xml]
indent_style = space
indent_size = 4

# Java
[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# Python (PEP 8)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# JavaScript / CSS / HTML / JSON
[*.{js,mjs,css,html,json}]
indent_style = space
indent_size = 2

# YAML / Docker Compose
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown — preserve trailing spaces (line breaks)
[*.md]
trim_trailing_whitespace = false
