{
  "version": 8,
  "name": "CzechTouristMap",
  "metadata": {
    "maputnik:renderer": "mbgljs",
    "maputnik:sources": {
      "openmaptiles": {
        "type": "vector",
        "minzoom": 0,
        "maxzoom": 14
      }
    }
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://{pmtiles_url}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#fdfdf0"
      }
    },
    {
      "id": "water-areas",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0c8f0"
      }
    },
    {
      "id": "landuse-forest",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "forest"],
      "paint": {
        "fill-color": "#c8e6c9"
      }
    },
    {
      "id": "landuse-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "grass"],
      "paint": {
        "fill-color": "#e8f5e9"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#f0f0f0",
        "fill-opacity": 0.6
      },
      "minzoom": 14
    },
    {
      "id": "highway-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": {
        "line-color": "#f9c74f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 14, 3]
      }
    },
    {
      "id": "highway-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "trunk"],
      "paint": {
        "line-color": "#ffb81a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.4, 14, 2.5]
      }
    },
    {
      "id": "highway-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "primary"],
      "paint": {
        "line-color": "#ffb81a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.3, 14, 2]
      }
    },
    {
      "id": "highway-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "secondary"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.2, 14, 1.5],
        "line-stroke": "#cccccc"
      }
    },
    {
      "id": "highway-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "tertiary"],
      "paint": {
        "line-color": "#f4f3ee",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.1, 14, 1]
      }
    },
    {
      "id": "highway-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "path"],
      "paint": {
        "line-color": "#8b9e7d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.2, 14, 0.8],
        "line-dasharray": [2, 2]
      },
      "minzoom": 12
    },
    {
      "id": "highway-footway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "footway"],
      "paint": {
        "line-color": "#b39ddb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.2, 14, 0.6]
      },
      "minzoom": 13
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", ["get", "class"], "river"],
      "paint": {
        "line-color": "#a0c8f0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.2, 14, 2]
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["==", ["get", "class"], "stream"],
      "paint": {
        "line-color": "#b8dff1",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.1, 14, 0.8]
      }
    },
    {
      "id": "admin-border-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], true]],
      "paint": {
        "line-color": "#8b7d7d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 14, 2],
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "admin-border-region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 4], ["!=", ["get", "maritime"], true]],
      "paint": {
        "line-color": "#b39ddb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.2, 14, 0.8],
        "line-dasharray": [2, 1]
      },
      "minzoom": 6
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", ["get", "class"], "city"]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Semibold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 10, 14, 16],
        "text-anchor": "center",
        "text-offset": [0, 1]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      },
      "minzoom": 7
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", ["get", "class"], "town"]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 9, 14, 13],
        "text-anchor": "center",
        "text-offset": [0, 1]
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      },
      "minzoom": 8
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", ["get", "class"], "village"]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 8, 14, 11],
        "text-anchor": "center",
        "text-offset": [0, 0.8]
      },
      "paint": {
        "text-color": "#999999",
        "text-halo-color": "#ffffff",
        "text-halo-width": 0.8
      },
      "minzoom": 10
    },
    {
      "id": "road-label-primary",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["==", ["get", "class"], "primary"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 0.8
      },
      "minzoom": 11
    }
  ]
}
