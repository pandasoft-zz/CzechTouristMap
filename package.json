{
  "name": "czech-tourist-map",
  "version": "0.1.0",
  "private": true,
  "description": "Tourist map of the Czech Republic as PMTiles with a MapLibre style",
  "type": "module",
  "license": "MIT",
  "bin": {
    "czmap": "tools/czmap.mjs"
  },
  "scripts": {
